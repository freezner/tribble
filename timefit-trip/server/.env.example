# Server only. Never use an EXPO_PUBLIC_ prefix for this key.
KAKAO_REST_API_KEY=
# Keep false for current-traffic estimates. Opt in only after future-API use is approved.
KAKAO_FUTURE_DRIVING_ENABLED=false
ROUTE_UPSTREAM_TIMEOUT_MS=8000
ROUTE_RATE_LIMIT_PER_MINUTE=30
# Per API, per running instance, rolling 24-hour limit. Not a global billing cap.
ROUTE_UPSTREAM_DAILY_LIMIT=900
ROUTE_MAX_CONCURRENT=4
# Enable only behind a loopback reverse proxy that overwrites X-Real-IP.
ROUTE_TRUST_LOCAL_PROXY=false
# Native apps do not send Origin. Add exact web origins only if web use is needed.
ROUTE_ALLOWED_ORIGINS=
