{
  "cli": {
    "version": ">= 13.2.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "Release",
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.2",
        "credentialsSource": "local"
      },
      "environment": "production",
      "node": "20.19.4",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6753949093",
        "appleId": "freezner3@gmail.com"
      }
    }
  }
}
