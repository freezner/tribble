# Optional legacy overseas routing key; domestic search/routes use the Kakao proxy.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Public HTTPS API base, e.g. https://your-server.example/api (without /route).
# KAKAO_REST_API_KEY belongs only in the server environment. See server/README.md.
EXPO_PUBLIC_KAKAO_API_URL=
